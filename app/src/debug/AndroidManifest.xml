<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (this source set is absent from every release variant).
  EngineBenchService: the silent on-device engine benchmark (issue #1, B1).
  OnnxBenchService: silent timing of any ONNX/ORT file (issue #12, X1).
  DevStateService: sets the onboarding flag and the device probe (issue #19).
  All exported so `adb shell am start-foreground-service` can reach them, but
  guarded by android.permission.DUMP — a signature|privileged permission the
  adb shell holds and no installed app can.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="app.marmalade.tts.devbench.EngineBenchService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Developer-only engine benchmark in debug builds; never shipped." />
        </service>
        <service
            android:name="app.marmalade.tts.devbench.OnnxBenchService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Developer-only model timing in debug builds; never shipped." />
        </service>
        <service
            android:name="app.marmalade.tts.devbench.DevStateService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Developer-only state setter in debug builds; never shipped." />
        </service>
    </application>
</manifest>
