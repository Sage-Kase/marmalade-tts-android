    <string name="onboarding_welcome_title">欢迎使用 Marmalade TTS</string>
    <string name="onboarding_welcome_body">Marmalade 用你选择的语音离线朗读文本。先选择一个引擎开始吧。</string>
    <string name="onboarding_get_started">开始使用</string>

    <string name="onboarding_engines_title">选择引擎</string>
    <string name="onboarding_engines_body">引擎在本机运行。之后你可以随时在“引擎”标签页安装更多。</string>
